# Local/deployed API configuration. Copy this file to .env and replace every placeholder.
# Admin login will return an error until ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_SESSION_SECRET and MongoDB are configured.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ksr_dairy?retryWrites=true&w=majority
MONGODB_DB=ksr_dairy

# Admin push notification recipient email(s), comma separated (not used for admin login)
ADMIN_EMAILS=admin@example.com
# Admin portal username/password login at /admin
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=use-a-long-random-password
ADMIN_SESSION_SECRET=use-a-different-long-random-secret

# Web Push (NOT email). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=put_generated_public_key_here
VAPID_PRIVATE_KEY=put_generated_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
