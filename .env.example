# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ksr_dairy?retryWrites=true&w=majority
MONGODB_DB=ksr_dairy

# ONE Google OAuth Web Client ID. The build exposes this public ID to the browser
# for Google sign-in and the API uses the same value to verify sign-in tokens.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Admin Google account email(s), comma separated
ADMIN_EMAILS=admin@example.com

# Web Push (NOT email). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=put_generated_public_key_here
VAPID_PRIVATE_KEY=put_generated_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# Optional: set true to require Google login before checkout
REQUIRE_LOGIN_FOR_CHECKOUT=false
